# LM Studio Configuration
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODELS_ENDPOINT=http://localhost:1234/v1/models
LM_STUDIO_EMBEDDINGS_ENDPOINT=http://localhost:1234/v1/embeddings
LM_STUDIO_CHAT_ENDPOINT=http://localhost:1234/v1/chat/completions

# Model Names
EMBEDDING_MODEL_NAME=text-embedding-nomic-embed-text-v1.5
LLM_MODEL_NAME=phi-3-mini-4k-instruct

# Timeouts & Prefixes
EMBEDDING_TASK_PREFIX=classification: 
EMBEDDING_TIMEOUT=120
REQUEST_TIMEOUT=120
